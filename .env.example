# Cryptex — environment template
# Copy to .env and fill in real values. Then `chmod 600 .env`.
#
# Replication flow:
#   ./replicate.sh --skeleton-env   # writes a populated-with-placeholders .env
#   nano .env                       # replace each CHANGE_ME_* with a real secret
#   ./replicate.sh --skip-secrets   # continue bootstrap
#
# Or run `./replicate.sh` (interactive) and answer each prompt.
#
# See SECRETS.md for where each secret comes from (B2 console, CF dashboard, etc.).
# ────────────────────────────────────────────────────────────────────────────────

# CRYPTEX — Generated 2026-03-30 00:59:20 UTC
# DO NOT commit this file

# Installation Profile (personal = all services, custom = DEPLOY_SERVICES list)
DEPLOY_PROFILE="CHANGE_ME"
DEPLOY_SERVICES="CHANGE_ME"

# Domain
DOMAIN="example.com"

# Cloudflare
CF_TUNNEL_TOKEN="CHANGE_ME_secret_32_chars"

# Tailscale
TS_AUTHKEY="CHANGE_ME_secret_32_chars"

# Gmail SMTP (used by Vaultwarden, DIUN, Moodle)
SMTP_USER="admin"
SMTP_PASSWORD="CHANGE_ME_password_24_chars"

# PostgreSQL
POSTGRES_USER="admin"
POSTGRES_PASSWORD="CHANGE_ME_password_24_chars"

# Moodle
MOODLE_DB_USER="admin"
MOODLE_DB_PASSWORD="CHANGE_ME_password_24_chars"
MOODLE_ADMIN_USER="admin"
MOODLE_ADMIN_PASSWORD="CHANGE_ME_password_24_chars"
MOODLE_ADMIN_EMAIL="you@example.com"
MOODLE_SITE_NAME="CHANGE_ME"

# TRAX LRS
TRAXLRS_DB_USER="admin"
TRAXLRS_DB_PASSWORD="CHANGE_ME_password_24_chars"
TRAXLRS_APP_KEY="CHANGE_ME_secret_32_chars"
TRAXLRS_ADMIN_EMAIL="you@example.com"
TRAXLRS_ADMIN_PASSWORD="CHANGE_ME_password_24_chars"
TRAXLRS_ENDPOINT_USERNAME="admin"
TRAXLRS_ENDPOINT_PASSWORD="CHANGE_ME_password_24_chars"

# n8n
N8N_DB_USER="admin"
N8N_DB_PASSWORD="CHANGE_ME_password_24_chars"
N8N_ENCRYPTION_KEY="CHANGE_ME_secret_32_chars"
N8N_ADMIN_EMAIL="you@example.com"
N8N_ADMIN_PASSWORD="CHANGE_ME_password_24_chars"

# n8n MCP — get from n8n UI → Settings → n8n API → Create API Key
N8N_API_KEY="CHANGE_ME_secret_32_chars"

# Tianji

# Vaultwarden
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_secret_32_chars

# AI API keys
GEMINI_API_KEY="CHANGE_ME_secret_32_chars"
OPENROUTER_KEY="CHANGE_ME_secret_32_chars"
GROQ_API_KEY="CHANGE_ME_secret_32_chars"
NVIDIA_NIM_API_KEY="CHANGE_ME_secret_32_chars"

# AdGuard Home
ADGUARD_ADMIN_USER="admin"
ADGUARD_ADMIN_PASSWORD="CHANGE_ME_password_24_chars"

# Vaultwarden user (reference — register at vault.DOMAIN with these)
VAULTWARDEN_USER_EMAIL="admin"
VAULTWARDEN_USER_PASSWORD="CHANGE_ME_password_24_chars"
VAULTWARDEN_SIGNUPS_ALLOWED="CHANGE_ME"

# Kopia
KOPIA_PASSWORD="CHANGE_ME_password_24_chars"
KOPIA_SERVER_USER="admin"
KOPIA_SERVER_PASSWORD="CHANGE_ME_password_24_chars"

# Git Identity (Workstation container)
GIT_AUTHOR_NAME="CHANGE_ME"
GIT_AUTHOR_EMAIL="you@example.com"

# Forgejo (self-hosted Git)
FORGEJO_DB_USER="admin"
FORGEJO_DB_PASSWORD="CHANGE_ME_password_24_chars"
FORGEJO_SECRET_KEY="CHANGE_ME_secret_32_chars"

# Woodpecker CI (get OAuth from Forgejo: Settings → Applications → OAuth2 Apps → Add)
WOODPECKER_FORGEJO_CLIENT_ID="CHANGE_ME"
WOODPECKER_FORGEJO_CLIENT_SECRET="CHANGE_ME_secret_32_chars"
WOODPECKER_AGENT_SECRET="CHANGE_ME_secret_32_chars"
WOODPECKER_DB_USER="admin"
WOODPECKER_DB_PASSWORD="CHANGE_ME_password_24_chars"

# Telegram Bot (n8n alerts + container management)
TELEGRAM_BOT_TOKEN="CHANGE_ME_secret_32_chars"
TELEGRAM_CHAT_ID="CHANGE_ME"

# PKM Bot (Claude Channels — Obsidian vault via Telegram)
PKM_BOT_TOKEN="CHANGE_ME_secret_32_chars"

# Redis password (all consumers: Moodle sessions, n8n)
REDIS_PASSWORD="CHANGE_ME_password_24_chars"

# Backblaze B2 (offsite backup)
B2_KEY_ID="CHANGE_ME_secret_32_chars"
B2_APP_KEY="CHANGE_ME_secret_32_chars"
B2_BUCKET_NAME="CHANGE_ME"
B2_ENDPOINT="CHANGE_ME"

# AquaSoul Studio (optional second site — leave blank to disable CF tunnel route)
AQUASOUL_DOMAIN="example.com"

# Bank Statement Automation (n8n IMAP trigger)
BANK_EMAIL_DOMAIN="you@example.com"
BANK_PDF_PASSWORD="CHANGE_ME_password_24_chars"

# ActualBudget (self-hosted budget tracker)
ACTUALBUDGET_PASSWORD="CHANGE_ME_password_24_chars"

# Miniflux (RSS reader)
MINIFLUX_DB_USER="admin"
MINIFLUX_DB_PASSWORD="CHANGE_ME_password_24_chars"
MINIFLUX_ADMIN_USER="admin"
MINIFLUX_ADMIN_PASSWORD="CHANGE_ME_password_24_chars"

# OpenWebUI
# OpenWebUI removed — replaced by LibreChat + MongoDB
SEARXNG_SECRET_KEY="CHANGE_ME_secret_32_chars"

# rclone WebDAV
RCLONE_WEBDAV_USER="admin"
RCLONE_WEBDAV_PASS="CHANGE_ME"

# ── Shlink — URL Shortener ──────────────────────────────────────────────────
SHLINK_DB_USER="admin"
SHLINK_DB_PASSWORD="CHANGE_ME_password_24_chars"
SHLINK_API_KEY="CHANGE_ME_secret_32_chars"
SHLINK_DOMAIN="example.com"

# ── Umami — Web Analytics ───────────────────────────────────────────────────
UMAMI_DB_USER="admin"
UMAMI_DB_PASSWORD="CHANGE_ME_password_24_chars"
UMAMI_APP_SECRET="CHANGE_ME_secret_32_chars"

# ── FerretDB — MongoDB wire → PostgreSQL (for LibreChat) ───────────────────
FERRETDB_DB_USER="admin"
FERRETDB_DB_PASSWORD="CHANGE_ME_password_24_chars"

# ── LibreChat — AI chat (replaces OpenWebUI) ────────────────────────────────
LIBRECHAT_JWT_SECRET="CHANGE_ME_secret_32_chars"
LIBRECHAT_JWT_REFRESH_SECRET="CHANGE_ME_secret_32_chars"
LIBRECHAT_CREDS_KEY="CHANGE_ME_secret_32_chars"
LIBRECHAT_CREDS_IV="CHANGE_ME"
LIBRECHAT_DB_USER="admin"
LIBRECHAT_DB_PASSWORD="CHANGE_ME_password_24_chars"

# ── PocketID — OIDC Identity Provider ────────────────────────────────────────
# Fill in after: deploy PocketID → create admin → create OIDC clients per service
# Then set VAULTWARDEN_SSO_ENABLED=true and LIBRECHAT_ALLOW_SOCIAL_LOGIN=true
# and MINIFLUX_OAUTH2_PROVIDER=oidc to activate per service.

VAULTWARDEN_SSO_ENABLED=CHANGE_ME
LIBRECHAT_ALLOW_SOCIAL_LOGIN=CHANGE_ME
# MINIFLUX_OAUTH2_PROVIDER=

# Client IDs + Secrets (copy from PocketID UI after creating each client)
POCKETID_LIBRECHAT_CLIENT_ID=CHANGE_ME
POCKETID_LIBRECHAT_CLIENT_SECRET=CHANGE_ME_secret_32_chars
POCKETID_LIBRECHAT_SESSION_SECRET=CHANGE_ME_secret_32_chars

POCKETID_VAULTWARDEN_CLIENT_ID=CHANGE_ME
POCKETID_VAULTWARDEN_CLIENT_SECRET=CHANGE_ME_secret_32_chars

POCKETID_MINIFLUX_CLIENT_ID=CHANGE_ME
POCKETID_MINIFLUX_CLIENT_SECRET=CHANGE_ME_secret_32_chars

POCKETID_FORGEJO_CLIENT_ID=CHANGE_ME
POCKETID_FORGEJO_CLIENT_SECRET=CHANGE_ME_secret_32_chars

POCKETID_ENCRYPTION_KEY=CHANGE_ME_secret_32_chars

# ── SilverBullet + capture (notes.psidex.com) — added 2026-05-02 ──
# 1. Visit https://id.psidex.com → OIDC Clients → New → name "notes"
# 2. Callback URL: https://notes.psidex.com/oauth2/callback
# 3. Paste client_id and client_secret below
POCKETID_NOTES_CLIENT_ID=CHANGE_ME
POCKETID_NOTES_CLIENT_SECRET=CHANGE_ME_secret_32_chars
POCKETID_NOTES_COOKIE_SECRET=CHANGE_ME_secret_32_chars
NOTES_CAPTURE_TOKEN=CHANGE_ME_secret_32_chars

# OB1 Memory Engine
OB1_DB_PASSWORD=CHANGE_ME_password_24_chars
OB1_API_KEY=CHANGE_ME_secret_32_chars
