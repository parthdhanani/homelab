# ---- Analysis / tooling artifacts ----
.understand-anything/
workspace/terminal/node_modules/
workspace/terminal/dist/

# ---- Secrets (NEVER commit) ----
secrets.env
.env
.env.local
.env.*.local
!.env.example
.env.encrypted
.dns-tokens.env
# nginx config embeds raw device tokens inline - never commit as plaintext;
# regenerate from .dns-tokens.env if restoring on a fresh box
system/nginx/sites-enabled/dns-doh-proxy.conf
*.key
*.pem
id_rsa*
id_ed25519*
github_key*
.credentials.json
secrets/
CREDENTIALS.md
configs/pgbouncer/userlist.txt

# ---- Stateful runtime data ----
data/
backups/
# Uncompressed mirror of the nightly dump; this is what kopia snapshots.
# Same class of data as backups/ — raw DB dumps, .env, vaultwarden keys.
# NOTE: any new dir holding backup output must be added here AND to the
# stack-config tar excludes in scripts/backup.sh, or it leaks/recurses.
backup-stage/
graphify-out/
scripts/graphify-out/
mcp/.venv/
*.db
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ---- Logs ----
*.log
logs/

# ---- Container state ----
.docker/
docker-compose.override.yml

# ---- Terraform state ----
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
terraform.tfvars
*.auto.tfvars

# ---- Editor / OS noise ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# ---- Local overrides ----
*.local
*.bak
*.bak.*
docker-compose.yml.bak*

# ---- Misc generated ----
node_modules/
__pycache__/
*.pyc
.pytest_cache/

# ---- Backups / temp ----
.git.local-backup-*
.rollback/

# ---- Claude runtime (excluded from dotfiles/ subset by rsync, belt-and-braces) ----
dotfiles/claude/cache/
dotfiles/claude/sessions/
dotfiles/claude/projects/
dotfiles/claude/telemetry/
dotfiles/claude/usage-data/
dotfiles/claude/daemon*
dotfiles/claude/history.jsonl
dotfiles/claude/paste-cache/
dotfiles/claude/file-history/
dotfiles/claude/shell-snapshots/
dotfiles/claude/jobs/
dotfiles/claude/.credentials.json
.claude/MEMORY.md

# Ignis (vendored external repo, built locally — not our source)
apps/ignis/
.code-review-graph/

# Duel runtime state: `secret` is the HMAC key that signs the emailed vote links, and the
# rest is live data regenerated by use. Ignored explicitly rather than just left unstaged —
# a future `git add -A` must not be able to publish the key, and this repo has a public
# derivative (github-public -> homelab).
duel/state/

# Distro-owned systemd units. backup.sh copies /etc/systemd/system/*.{service,timer}
# wholesale, which sweeps in units apt/snap install and rewrite on every upgrade.
# Only cryptex-owned units belong in this repo — a package bump must not dirty it,
# and restoring a distro's own unit file onto a fresh box is at best a no-op.
system/systemd/sshd.service
system/systemd/sudo.service
system/systemd/syslog.service
system/systemd/rpcbind.service
system/systemd/iscsi.service
system/systemd/multipath-tools.service
system/systemd/vmtoolsd.service
system/systemd/systemd-resolved.service
system/systemd/dbus-org.freedesktop.timesync1.service
system/systemd/fwupd.service
system/systemd/fwupd-refresh.service
system/systemd/snap.*.service

# v2-rebuild terraform archive. Untracked deliberately in 49735be (2026-05-27):
# terraform.tfvars carries the OCI tenancy/user OCIDs and API-key fingerprint, and
# tfstate carries private IPs. Neither is in history — keep it that way. This repo
# has a public derivative (github-public -> homelab).
legacy/
