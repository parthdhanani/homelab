# CRYPTEX Rebuild — Environment Variables
# Copy to .env and fill in values, or use ./scripts/setup-env.sh to generate
# chmod 600 .env after editing
# All values MUST be quoted (for safe bash sourcing)

# ── Installation Profile ──
# personal = all 22 services; custom = comma-separated list written by setup-env.sh
DEPLOY_PROFILE="personal"
DEPLOY_SERVICES="all"

# ── Domain ──
DOMAIN="psidex.com"

# ── AquaSoul Studio (optional second site — leave blank to disable) ──
AQUASOUL_DOMAIN=""

# ── Cloudflare ──
CF_TUNNEL_TOKEN="your-cloudflare-tunnel-token"

# ── Tailscale ──
TS_AUTHKEY="tskey-auth-xxxxx"

# ── Gmail SMTP (used by Vaultwarden, DIUN, Moodle) ──
# Get an App Password: Google Account → Security → 2-Step → App Passwords
SMTP_USER="your-gmail@gmail.com"
SMTP_PASSWORD="your-16-char-app-password"

# ── PostgreSQL (root) ──
POSTGRES_USER="cryptex_admin"
POSTGRES_PASSWORD="generate-24-char-password"

# ── Moodle ──
MOODLE_DB_USER="moodle_user"
MOODLE_DB_PASSWORD="generate-24-char-password"
MOODLE_ADMIN_USER="admin"
MOODLE_ADMIN_PASSWORD="generate-16-char-password"
MOODLE_ADMIN_EMAIL="admin@psidex.com"
MOODLE_SITE_NAME="PSIDEX Learning"

# ── TRAX LRS ──
TRAXLRS_DB_USER="traxlrs_user"
TRAXLRS_DB_PASSWORD="generate-24-char-password"
TRAXLRS_APP_KEY="base64:generate-32-byte-key"
TRAXLRS_ADMIN_EMAIL="admin@psidex.com"
TRAXLRS_ADMIN_PASSWORD="generate-16-char-password"
TRAXLRS_ENDPOINT_USERNAME="lrsuser"             # xAPI endpoint — used by Moodle SCORM/xAPI
TRAXLRS_ENDPOINT_PASSWORD="generate-16-char-password"

# ── n8n ──
N8N_DB_USER="n8n_user"
N8N_DB_PASSWORD="generate-24-char-password"
N8N_ENCRYPTION_KEY="generate-32-char-hex"
N8N_ADMIN_EMAIL="your-email@gmail.com"       # used by deploy.sh to setup n8n owner + activate workflows
N8N_ADMIN_PASSWORD="generate-16-char-password"

# ── Tianji ──
TIANJI_DB_USER="tianji_user"
TIANJI_DB_PASSWORD="generate-24-char-password"
TIANJI_JWT_SECRET="generate-32-char-hex"

# ── Vaultwarden ──
# Admin panel token: access https://vault.<DOMAIN>/admin
VAULTWARDEN_ADMIN_TOKEN="generate-long-random-token"
# User account (register at vault.<DOMAIN>/register, then disable signups)
VAULTWARDEN_USER_EMAIL="you@example.com"
VAULTWARDEN_USER_PASSWORD="generate-16-char-password"
VAULTWARDEN_SIGNUPS_ALLOWED="false"          # set to true temporarily to register first account, then back to false

# ── Gemini API (AI workflows — morning digest, weekly analysis, workstation) ──
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── OpenWebUI ──
# Admin email: same as SMTP_USER (your Gmail)
# Password: set on first deploy, stored here for reference
OPENWEBUI_ADMIN_PASSWORD="generate-20-char-password"
OPENWEBUI_SIGNUP_ENABLED="false"

# ── SearXNG ──
# Random secret key — generate with: openssl rand -hex 32
SEARXNG_SECRET_KEY="$(openssl rand -hex 32)"

# ── AdGuard Home ──
ADGUARD_ADMIN_USER="admin"
ADGUARD_ADMIN_PASSWORD="generate-16-char-password"

# ── Kopia ──
KOPIA_PASSWORD="generate-24-char-password"
KOPIA_SERVER_USER="admin"
KOPIA_SERVER_PASSWORD="generate-24-char-password"

# ── Git Identity (Workstation container) ──
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"

# ── Forgejo (self-hosted Git) ──
FORGEJO_DB_USER="forgejo_user"
FORGEJO_DB_PASSWORD="generate-24-char-password"
FORGEJO_SECRET_KEY="generate-64-char-hex"    # Internal encryption secret — generate with: openssl rand -hex 32

# ── Telegram Bot (n8n real-time alerts + container management) ──
# Create: Telegram → @BotFather → /newbot → copy token
# Chat ID: Message bot, then GET https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-numeric-chat-id"

# ── Miniflux (RSS reader + AI digest source) ──
MINIFLUX_DB_USER="miniflux_user"
MINIFLUX_DB_PASSWORD="generate-24-char-password"
MINIFLUX_ADMIN_USER="admin"
MINIFLUX_ADMIN_PASSWORD="generate-16-char-password"

# ── Backblaze B2 (offsite backup via rclone) ──
# Create bucket: B2 → Buckets → Create → private
# Create key: B2 → App Keys → Add New → restrict to bucket
B2_KEY_ID="your-b2-key-id"
B2_APP_KEY="your-b2-application-key"
B2_BUCKET_NAME="your-b2-bucket-name"

# ── Bank Statement Automation ──
# n8n watches Gmail inbox for emails from your bank, auto-processes PDF statements
BANK_EMAIL_DOMAIN="hdfcbank.com"         # sender domain to filter (e.g. icicibank.com)
BANK_PDF_PASSWORD="your-pdf-password"    # PDF password — usually DOB in DDMMYYYY format

# ── ActualBudget (self-hosted budget tracker) ──
ACTUALBUDGET_PASSWORD="generate-16-char-password"

# ── Redis password (all internal consumers: Moodle sessions, n8n) ──
REDIS_PASSWORD="generate-24-char-password"

# ── PKM Bot (Claude Channels — Obsidian vault via Telegram) ──
# Create separately from infra bot: @BotFather → /newbot
# Leave blank to disable PKM Claude Channels autostart
PKM_BOT_TOKEN=""

# ── Forgejo registration (true = open for first account creation) ──
FORGEJO_DISABLE_REGISTRATION="false"

# ── rclone WebDAV (files.DOMAIN — Finder + iOS Files mount) ──
# These credentials protect the WebDAV endpoint (behind Cloudflare Zero Trust as well)
RCLONE_WEBDAV_USER="cryptex"
RCLONE_WEBDAV_PASS="generate-24-char-password"
