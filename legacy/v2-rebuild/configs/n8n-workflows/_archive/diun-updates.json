{
  "name": "CRYPTEX: DIUN Update → Claude Research → Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "diun",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook-diun",
      "name": "DIUN Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-new",
              "leftValue": "={{ $json.status }}",
              "rightValue": "new",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-new",
      "name": "Filter New Updates Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=📦 **Update Detected**\n\nContainer: `{{ $json.container }}`\nImage: `{{ $json.image }}`\n\n⏳ Researching changelog with Claude Code...",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-researching",
      "name": "Notify Researching",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [600, 300],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cryptex-socket-proxy:2375/containers/cryptex-workstation/exec",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ AttachStdout: true, AttachStderr: true, Cmd: ['claude', '-p', 'Research the Docker image update for ' + $('DIUN Webhook').item.json.image + '. Check the GitHub releases page or changelog. Answer in this exact format (max 500 chars):\\n\\nSAFE or UNSAFE\\nVersion: old → new\\nChanges: (3 bullet points max)\\nBreaking: yes/no\\nRecommendation: (one line)'] }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "create-exec",
      "name": "Create Claude Exec",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://cryptex-socket-proxy:2375/exec/{{ $json.Id }}/start",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"Detach\": false, \"Tty\": false}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "start-exec",
      "name": "Run Claude Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Parse Docker exec output (has 8-byte header frames)\nconst raw = $input.first().json.body || $input.first().json.data || '';\n// Strip Docker stream headers (non-printable chars)\nconst clean = typeof raw === 'string' \n  ? raw.replace(/[\\x00-\\x09\\x0b-\\x1f]/g, '').trim()\n  : JSON.stringify(raw);\n\nconst container = $('DIUN Webhook').first().json.container || 'unknown';\nconst image = $('DIUN Webhook').first().json.image || 'unknown';\n\nlet analysis = clean.substring(0, 1500) || 'Claude Code analysis unavailable (auth may need refresh)';\n\nreturn [{\n  json: {\n    text: `📦 **Update Analysis**\\n\\nContainer: \\`${container}\\`\\nImage: \\`${image}\\`\\n\\n${analysis}\\n\\n---\\nReply \\`update ${container}\\` to proceed.`,\n    container: container\n  }\n}];"
      },
      "id": "format-analysis",
      "name": "Format Analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1350, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-analysis",
      "name": "Send Analysis",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1600, 300],
      "credentials": {
        "telegramApi": {
          "id": "CONFIGURE_ME",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "DIUN Webhook": {
      "main": [
        [
          {
            "node": "Filter New Updates Only",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Filter New Updates Only": {
      "main": [
        [
          {
            "node": "Notify Researching",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Researching": {
      "main": [
        [
          {
            "node": "Create Claude Exec",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Claude Exec": {
      "main": [
        [
          {
            "node": "Run Claude Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Claude Analysis": {
      "main": [
        [
          {
            "node": "Format Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Analysis": {
      "main": [
        [
          {
            "node": "Send Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "cryptex"
    }
  ]
}
