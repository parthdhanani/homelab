{
  "id": "cryptex-command-handler",
  "name": "CRYPTEX: Telegram Command Handler (restart, update, diagnose, status, rollback)",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 400],
      "credentials": {
        "telegramApi": {
          "id": "a0000000-0000-0000-0000-000000000001",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-owner",
              "leftValue": "={{ $json.message.chat.id }}",
              "rightValue": "={{ $env.TELEGRAM_CHAT_ID }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "verify-owner",
      "name": "Verify Owner",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [400, 400]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputIndex": 0,
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.text.toLowerCase() }}",
                    "rightValue": "restart",
                    "operator": { "type": "string", "operation": "startsWith" }
                  }
                ]
              }
            },
            {
              "outputIndex": 1,
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.text.toLowerCase() }}",
                    "rightValue": "update",
                    "operator": { "type": "string", "operation": "startsWith" }
                  }
                ]
              }
            },
            {
              "outputIndex": 2,
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.text.toLowerCase() }}",
                    "rightValue": "status",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              }
            },
            {
              "outputIndex": 3,
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.text.toLowerCase() }}",
                    "rightValue": "diagnose",
                    "operator": { "type": "string", "operation": "startsWith" }
                  }
                ]
              }
            },
            {
              "outputIndex": 4,
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.message.text.toLowerCase() }}",
                    "rightValue": "rollback",
                    "operator": { "type": "string", "operation": "startsWith" }
                  }
                ]
              }
            }
          ]
        }
      },
      "id": "route-command",
      "name": "Route Command",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [600, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://cryptex-socket-proxy:2375/containers/{{ $json.message.text.toLowerCase().replace('restart ', '').trim() }}/restart",
        "options": { "timeout": 30000 }
      },
      "id": "docker-restart",
      "name": "Docker Restart",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 200],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $statusCode === 204 ? '✅ Restarted `' + $('Telegram Trigger').item.json.message.text.toLowerCase().replace('restart ', '').trim() + '`' : '❌ Restart failed — container not found or error' }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-restart-result",
      "name": "Report Restart",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1100, 200],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⏳ **Updating container...**\n\n`{{ $json.message.text.toLowerCase().replace('update ', '').trim() }}`\n\nPulling new image + recreating. Will notify when done (1-2 min).",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-update-start",
      "name": "Notify Update Start",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [850, 350],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cryptex-socket-proxy:2375/containers/cryptex-workstation/exec",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ AttachStdout: true, AttachStderr: true, Cmd: ['bash', '-c', 'cd /opt/cryptex 2>/dev/null || true && container=\"' + $('Telegram Trigger').item.json.message.text.toLowerCase().replace('update ', '').trim() + '\" && docker compose pull \"${container#cryptex-}\" && docker compose up -d --no-deps \"${container#cryptex-}\" && sleep 10 && docker inspect --format=\"{{.State.Health.Status}}\" \"$container\" 2>/dev/null || echo running'] }) }}",
        "options": { "timeout": 180000 }
      },
      "id": "docker-update-exec",
      "name": "Run Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 350],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://cryptex-socket-proxy:2375/exec/{{ $json.Id }}/start",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"Detach\": false, \"Tty\": false}",
        "options": { "timeout": 180000 }
      },
      "id": "start-update-exec",
      "name": "Execute Update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 350],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.statusCode < 300 ? '✅ Update complete. Container recreated with new image.' : '❌ Update may have failed. Check logs:\\n`docker logs ' + $('Telegram Trigger').item.json.message.text.toLowerCase().replace('update ', '').trim() + ' --tail 20`' }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-update-result",
      "name": "Report Update",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1600, 350],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "url": "http://cryptex-socket-proxy:2375/containers/json",
        "options": { "timeout": 10000 }
      },
      "id": "docker-status",
      "name": "Docker Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 500]
    },
    {
      "parameters": {
        "jsCode": "const containers = $input.all()[0].json;\nconst lines = containers.map(c => {\n  const name = c.Names[0].replace('/', '');\n  const state = c.State;\n  const status = c.Status;\n  const icon = state === 'running' ? '🟢' : '🔴';\n  return `${icon} \\`${name}\\` — ${status}`;\n}).sort();\nconst running = containers.filter(c => c.State === 'running').length;\nreturn [{ json: { text: `**CRYPTEX Status**\\n\\n${lines.join('\\n')}\\n\\n${running}/${containers.length} running` } }];"
      },
      "id": "format-status",
      "name": "Format Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 500]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-status",
      "name": "Send Status",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1350, 500],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔍 **Diagnosing with Claude Code...**\n\n`{{ $json.message.text.toLowerCase().replace('diagnose ', '').trim() }}`\n\nThis may take 30-60 seconds.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-diag-start",
      "name": "Notify Diagnosing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [850, 650],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cryptex-socket-proxy:2375/containers/cryptex-workstation/exec",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ AttachStdout: true, AttachStderr: true, Cmd: ['claude', '-p', '--max-turns', '3', 'Container ' + $('Telegram Trigger').item.json.message.text.toLowerCase().replace('diagnose ', '').trim() + ' is failing health checks on my Oracle ARM64 VPS running Docker Compose. Get the last 50 lines of logs with: docker logs ' + $('Telegram Trigger').item.json.message.text.toLowerCase().replace('diagnose ', '').trim() + ' --tail 50. Then diagnose the root cause. Answer in this format (max 800 chars):\\n\\nSTATUS: (critical/warning/info)\\nCAUSE: (one line root cause)\\nFIX: (numbered steps to fix, max 3)\\nCAN_AUTO_FIX: yes/no'] }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "create-diag-exec",
      "name": "Create Diagnose Exec",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 650],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://cryptex-socket-proxy:2375/exec/{{ $json.Id }}/start",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"Detach\": false, \"Tty\": false}",
        "options": { "timeout": 120000 }
      },
      "id": "start-diag-exec",
      "name": "Run Diagnosis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 650],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body || $input.first().json.data || '';\nconst clean = typeof raw === 'string'\n  ? raw.replace(/[\\x00-\\x09\\x0b-\\x1f]/g, '').trim()\n  : JSON.stringify(raw);\n\nconst container = $('Telegram Trigger').first().json.message.text.toLowerCase().replace('diagnose ', '').trim();\nlet diagnosis = clean.substring(0, 2000) || 'Claude Code unavailable — auth token may need refresh.\\nSSH in and run: docker exec -it cryptex-workstation claude auth login';\n\nreturn [{\n  json: {\n    text: `🔍 **Diagnosis: \\`${container}\\`**\\n\\n${diagnosis}\\n\\n---\\nCommands: \\`restart ${container}\\` or \\`update ${container}\\``\n  }\n}];"
      },
      "id": "format-diagnosis",
      "name": "Format Diagnosis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 650]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-diagnosis",
      "name": "Send Diagnosis",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1850, 650],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=⏪ **Rolling back...**\n\n`{{ $json.message.text.toLowerCase().replace('rollback ', '').trim() }}`\n\nRestoring previous image version.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-rollback-start",
      "name": "Notify Rollback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [850, 800],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://cryptex-socket-proxy:2375/containers/cryptex-workstation/exec",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ AttachStdout: true, AttachStderr: true, Cmd: ['bash', '-c', 'service=\"' + $('Telegram Trigger').item.json.message.text.toLowerCase().replace('rollback ', '').trim() + '\" && rollback_file=\"/opt/cryptex/.rollback/${service#cryptex-}\" && if [ -f \"$rollback_file\" ]; then old_image=$(cat \"$rollback_file\") && compose_image=$(cd /opt/cryptex && docker compose images \"${service#cryptex-}\" --format \"{{.Repository}}:{{.Tag}}\" 2>/dev/null | head -1) && docker tag \"$old_image\" \"$compose_image\" 2>/dev/null && cd /opt/cryptex && docker compose up -d --no-deps --force-recreate \"${service#cryptex-}\" && sleep 10 && state=$(docker inspect --format=\"{{.State.Status}}\" \"cryptex-${service#cryptex-}\" 2>/dev/null) && echo \"ROLLBACK_OK:$state\"; else echo \"ROLLBACK_FAIL:no rollback image saved for $service\"; fi'] }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "create-rollback-exec",
      "name": "Create Rollback Exec",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 800],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://cryptex-socket-proxy:2375/exec/{{ $json.Id }}/start",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"Detach\": false, \"Tty\": false}",
        "options": { "timeout": 120000 }
      },
      "id": "start-rollback-exec",
      "name": "Run Rollback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 800],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.body || $input.first().json.data || '';\nconst clean = typeof raw === 'string'\n  ? raw.replace(/[\\x00-\\x09\\x0b-\\x1f]/g, '').trim()\n  : JSON.stringify(raw);\n\nconst service = $('Telegram Trigger').first().json.message.text.toLowerCase().replace('rollback ', '').trim();\nconst success = clean.includes('ROLLBACK_OK');\n\nreturn [{\n  json: {\n    text: success\n      ? `✅ **Rolled back \\`${service}\\`**\\n\\nPrevious image restored and container recreated.`\n      : `❌ **Rollback failed for \\`${service}\\`**\\n\\n${clean.replace('ROLLBACK_FAIL:', '') || 'No rollback image available. Run \\`update\\` first to create a rollback point.'}\\n\\nTry: \\`diagnose ${service}\\``\n  }\n}];"
      },
      "id": "format-rollback",
      "name": "Format Rollback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1600, 800]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.text }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "telegram-rollback-result",
      "name": "Send Rollback Result",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1850, 800],
      "credentials": { "telegramApi": { "id": "a0000000-0000-0000-0000-000000000001", "name": "Telegram Bot" } }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Verify Owner", "type": "main", "index": 0 }]]
    },
    "Verify Owner": {
      "main": [[{ "node": "Route Command", "type": "main", "index": 0 }]]
    },
    "Route Command": {
      "main": [
        [{ "node": "Docker Restart", "type": "main", "index": 0 }],
        [{ "node": "Notify Update Start", "type": "main", "index": 0 }],
        [{ "node": "Docker Status", "type": "main", "index": 0 }],
        [{ "node": "Notify Diagnosing", "type": "main", "index": 0 }],
        [{ "node": "Notify Rollback", "type": "main", "index": 0 }]
      ]
    },
    "Docker Restart": {
      "main": [[{ "node": "Report Restart", "type": "main", "index": 0 }]]
    },
    "Notify Update Start": {
      "main": [[{ "node": "Run Update", "type": "main", "index": 0 }]]
    },
    "Run Update": {
      "main": [[{ "node": "Execute Update", "type": "main", "index": 0 }]]
    },
    "Execute Update": {
      "main": [[{ "node": "Report Update", "type": "main", "index": 0 }]]
    },
    "Docker Status": {
      "main": [[{ "node": "Format Status", "type": "main", "index": 0 }]]
    },
    "Format Status": {
      "main": [[{ "node": "Send Status", "type": "main", "index": 0 }]]
    },
    "Notify Diagnosing": {
      "main": [[{ "node": "Create Diagnose Exec", "type": "main", "index": 0 }]]
    },
    "Create Diagnose Exec": {
      "main": [[{ "node": "Run Diagnosis", "type": "main", "index": 0 }]]
    },
    "Run Diagnosis": {
      "main": [[{ "node": "Format Diagnosis", "type": "main", "index": 0 }]]
    },
    "Format Diagnosis": {
      "main": [[{ "node": "Send Diagnosis", "type": "main", "index": 0 }]]
    },
    "Notify Rollback": {
      "main": [[{ "node": "Create Rollback Exec", "type": "main", "index": 0 }]]
    },
    "Create Rollback Exec": {
      "main": [[{ "node": "Run Rollback", "type": "main", "index": 0 }]]
    },
    "Run Rollback": {
      "main": [[{ "node": "Format Rollback", "type": "main", "index": 0 }]]
    },
    "Format Rollback": {
      "main": [[{ "node": "Send Rollback Result", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "cryptex" }]
}
