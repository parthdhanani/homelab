{
  "id": "cryptex-movie-search",
  "name": "CRYPTEX: Movie Search (JustWatch)",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 300],
      "credentials": {
        "telegramApi": {
          "id": "a0000000-0000-0000-0000-000000000001",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "is-owner",
              "leftValue": "={{ $json.message.chat.id.toString() }}",
              "rightValue": "={{ $env.TELEGRAM_CHAT_ID }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "is-movie-cmd",
              "leftValue": "={{ $json.message.text.toLowerCase() }}",
              "rightValue": "movie",
              "operator": {
                "type": "string",
                "operation": "startsWith"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "filter-movie-cmd",
      "name": "Filter Movie Command",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "url": "=http://cryptex-jwbot:5000/search?q={{ encodeURIComponent($json.message.text.trim().replace(/^\\S+\\s+/, '').trim()) }}&country=IN",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "jwbot-search",
      "name": "JustWatch Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.body || $json.data || 'Search failed — jwbot may be starting up. Try again in a moment.' }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": true
        }
      },
      "id": "telegram-send",
      "name": "Send Result",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [860, 300],
      "credentials": {
        "telegramApi": {
          "id": "a0000000-0000-0000-0000-000000000001",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [[{ "node": "Filter Movie Command", "type": "main", "index": 0 }]]
    },
    "Filter Movie Command": {
      "main": [[{ "node": "JustWatch Search", "type": "main", "index": 0 }]]
    },
    "JustWatch Search": {
      "main": [[{ "node": "Send Result", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "cryptex" }]
}
