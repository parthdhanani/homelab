[Unit]
Description=Zellij proxy — forwards 172.18.0.1:8082 to Zellij loopback
# Needed because Zellij requires SSL cert to bind outside 127.0.0.1
# cloudflared runs in Docker and cannot reach host 127.0.0.1
# socat bridges: 172.18.0.1:8082 (Docker bridge host IP) → 127.0.0.1:8082 (Zellij)
After=zellij-web.service
Requires=zellij-web.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP-LISTEN:8082,bind=172.18.0.1,fork,reuseaddr TCP:127.0.0.1:8082
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
