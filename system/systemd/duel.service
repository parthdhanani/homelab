[Unit]
Description=Taste duel — poster-vs-poster ranking over PKM watched films
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/cryptex/duel
ExecStart=/usr/bin/python3 /opt/cryptex/duel/duel.py
Restart=on-failure
RestartSec=5
MemoryMax=128M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/cryptex/duel/state /opt/cryptex/data/pkm

[Install]
WantedBy=multi-user.target
