[Unit]
Description=Zellij Web Server — cryptex terminal (code.psidex.com)
Documentation=https://zellij.dev/documentation/web-client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
Environment="HOME=/home/ubuntu"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="TERM=xterm-256color"
Environment="COLORTERM=truecolor"
ExecStart=/usr/local/bin/zellij web --ip 127.0.0.1 --port 8082
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
