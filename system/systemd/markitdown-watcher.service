[Unit]
Description=markitdown watcher — converts dropped docs to Markdown for the PKM vault
After=network.target

[Service]
Type=simple
User=ubuntu
ExecStart=/home/ubuntu/.claude/hooks/markitdown-watcher.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
