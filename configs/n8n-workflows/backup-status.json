{
  "id": "cryptex-backup-status",
  "name": "CRYPTEX: Backup Status → Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "backup-status",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook-backup",
      "name": "Backup Status Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.status === 'success' ? '✅' : '❌' }} **Backup {{ $json.status === 'success' ? 'Complete' : 'FAILED' }}**\n\nFile: `{{ $json.file }}`\nSize: {{ $json.size }}\nTime: {{ $json.timestamp }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "telegram-backup",
      "name": "Send Backup Status",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [450, 300],
      "credentials": {
        "telegramApi": {
          "id": "a0000000-0000-0000-0000-000000000001",
          "name": "Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Backup Status Webhook": {
      "main": [
        [
          {
            "node": "Send Backup Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "cryptex"
    }
  ]
}
