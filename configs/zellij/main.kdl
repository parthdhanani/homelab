// Zellij layout — cryptex terminal
// Zellaude status bar + main shell pane

layout {
    default_tab_template {
        // Zellaude status bar — Claude Code activity awareness
        pane size=1 borderless=true {
            plugin location="file:///home/ubuntu/.config/zellij/plugins/zellaude.wasm"
        }
        // Main terminal area
        children
    }
    // Default tab on open
    tab name="main" focus=true {
        pane
    }
}
