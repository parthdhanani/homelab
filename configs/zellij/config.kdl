// Zellij config — cryptex VPS
// Web server: zellij-web.service → 127.0.0.1:8082
// Proxy: zellij-proxy.service → 172.18.0.1:8082 (cloudflared bridge)
// Access: https://code.psidex.com

themes {
    catppuccin-mocha {
        fg "#cdd6f4"
        bg "#1e1e2e"
        black "#45475a"
        red "#f38ba8"
        green "#a6e3a1"
        yellow "#f9e2af"
        blue "#89b4fa"
        magenta "#cba6f7"
        cyan "#89dceb"
        white "#cdd6f4"
        orange "#fab387"
    }
}

theme "catppuccin-mocha"

default_layout "compact"

// Mouse mode: enables pane clicking + scrolling
// To copy text (URLs etc): hold Shift while selecting — bypasses Zellij, uses browser native selection
mouse_mode true

// Session serialization — resurrect sessions after reboot
session_serialization false

// Copy to system clipboard on selection release (works in native terminal, not web)
// In web: use Shift+select to bypass Zellij mouse capture → browser handles copy
copy_on_select false

// Scroll buffer — more lines = easier URL copying
scroll_buffer_size 10000
